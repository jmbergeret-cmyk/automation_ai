---
import { legal, navLinks, site, social } from '../data/site.js';
const year = new Date().getFullYear();
---

<footer class="bg-forest-deep text-cream">
  <div class="container-x py-20 lg:py-24">
    <div class="grid gap-14 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-5">
        <p class="font-display text-[2.6rem] leading-none font-bold tracking-[-0.04em] lg:text-[3.2rem]">
          Saladbowl
        </p>
        <p class="mt-5 max-w-[32ch] leading-relaxed text-cream/70">
          Bowls frescos, hechos al momento. Pocitos, Ciudad Vieja y Carrasco.
        </p>
        <a
          href={site.orderUrl}
          target="_blank"
          rel="noopener"
          class="mt-8 inline-flex rounded-full bg-leaf px-7 py-3.5 font-semibold text-white transition-colors duration-200 hover:bg-leaf-dark"
        >
          Hacé tu pedido
        </a>
      </div>

      <nav class="lg:col-span-3" aria-label="Secciones">
        <h2 class="text-[0.75rem] font-medium tracking-[0.18em] text-cream/45 uppercase">Sitio</h2>
        <ul class="mt-5 space-y-3">
          {
            navLinks.map((link) => (
              <li>
                <a href={link.href} class="text-cream/85 transition-colors hover:text-citrus">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="lg:col-span-2">
        <h2 class="text-[0.75rem] font-medium tracking-[0.18em] text-cream/45 uppercase">Redes</h2>
        <ul class="mt-5 space-y-3">
          {
            social.map((item) => (
              <li>
                <a
                  href={item.href}
                  target="_blank"
                  rel="noopener"
                  class="text-cream/85 transition-colors hover:text-citrus"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="lg:col-span-2">
        <h2 class="text-[0.75rem] font-medium tracking-[0.18em] text-cream/45 uppercase">
          Contacto
        </h2>
        <ul class="mt-5 space-y-3">
          <li>
            <a href={`mailto:${site.email}`} class="text-cream/85 transition-colors hover:text-citrus">
              {site.email}
            </a>
          </li>
          <li>
            <a href={site.whatsapp} target="_blank" rel="noopener" class="text-cream/85 transition-colors hover:text-citrus">
              WhatsApp
            </a>
          </li>
          <li class="text-cream/60">{site.phone}</li>
        </ul>
      </div>
    </div>

    <div
      class="mt-16 flex flex-col gap-4 border-t border-cream/15 pt-8 text-[0.85rem] text-cream/55 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} Saladbowl. Montevideo, Uruguay.</p>
      <ul class="flex gap-6">
        {
          legal.map((item) => (
            <li>
              <a href={item.href} class="transition-colors hover:text-citrus">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
