---
import StatusBadge from './StatusBadge.astro';

interface Props {
  place: {
    name: string;
    schedule: string;
    note: string;
    image: string;
    hours: Record<string, [string, string][]>;
  };
}
const { place } = Astro.props;
---

<article data-reveal class="flex flex-col">
  <div data-media class="aspect-[3/2] overflow-hidden rounded-[1.25rem] bg-crema-2">
    <img
      src={place.image}
      alt={`Local de Saladbowl en ${place.name}`}
      width="1200"
      height="800"
      loading="lazy"
      class="h-full w-full object-cover"
    />
  </div>

  <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2">
    <h3 class="text-[1.6rem]">{place.name}</h3>
    <StatusBadge hours={place.hours} />
  </div>

  <p class="mt-3 text-[0.98rem] opacity-70">{place.schedule}</p>
  <p class="mt-2 text-[0.92rem] opacity-55">{place.note}</p>
</article>
