---
import { locations } from '../../data/locations.js';
---

<section id="locales" class="py-24 lg:py-36">
  <div class="container-x">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <h2 data-reveal class="max-w-[16ch] text-[2.6rem] sm:text-[3.4rem] lg:text-[4.2rem]">
        Tres locales en Montevideo
      </h2>
      <a data-reveal data-delay="0.1" href="/locales" class="link-arrow pb-2 font-medium">
        Ver todos los locales
      </a>
    </div>

    <div data-stagger class="mt-14 grid gap-x-6 gap-y-12 md:grid-cols-3 lg:mt-20">
      {
        locations.map((place) => (
          <article data-reveal class="flex flex-col">
            <div data-media class="aspect-[3/2] overflow-hidden rounded-[1.25rem] bg-cream-deep">
              <img
                src={place.image}
                alt={`Local de Saladbowl en ${place.name}`}
                width="1200"
                height="800"
                loading="lazy"
                class="h-full w-full object-cover"
              />
            </div>

            <h3 class="mt-6 text-[1.6rem]">{place.name}</h3>
            <p class="mt-3 text-[0.98rem] text-forest-soft">{place.address}</p>
            <p class="mt-1 text-[0.98rem] text-forest-soft">{place.hours}</p>
            <p class="mt-3 text-[0.92rem] text-forest/55">{place.note}</p>

            <a
              href={place.mapUrl}
              target="_blank"
              rel="noopener"
              class="link-arrow mt-5 text-[0.95rem] font-medium"
            >
              Cómo llegar
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
