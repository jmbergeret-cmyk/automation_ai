---
import { hero, site } from '../../data/site.js';
---

<section data-hero class="relative flex min-h-svh items-center pt-28 pb-16 lg:pt-32 lg:pb-24">
  <div class="container-x grid w-full items-center gap-12 lg:grid-cols-12 lg:gap-12 xl:gap-16">
    <div class="lg:col-span-6">
      <p
        data-hero-item
        class="mb-6 text-[0.78rem] font-medium tracking-[0.18em] text-citrus uppercase"
      >
        Montevideo · desde 2019
      </p>

      <h1 data-hero-item class="text-[3.4rem] sm:text-[4.5rem] md:text-[5rem] lg:text-[4.2rem] xl:text-[5.4rem]">
        Comida real,<br />sin vueltas.
      </h1>

      <p
        data-hero-item
        class="mt-7 max-w-[46ch] text-[1.05rem] leading-relaxed text-cream/75 lg:text-[1.15rem]"
      >
        Bowls que armamos a la vista, con verdura que compramos cada mañana. Pedís, esperás cinco
        minutos y seguís con tu día.
      </p>

      <div data-hero-item class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
        <a
          href={site.orderUrl}
          target="_blank"
          rel="noopener"
          class="rounded-full bg-leaf px-8 py-4 font-semibold text-white transition-colors duration-200 hover:bg-leaf-dark"
        >
          Hacé tu pedido
        </a>
        <a href="/menu" class="link-arrow font-medium">Ver el menú</a>
      </div>
    </div>

    <div class="lg:col-span-6 lg:col-start-7">
      <div
        data-hero-media
        data-parallax-frame
        class="relative aspect-[4/5] overflow-hidden rounded-[1.75rem] bg-forest-mid sm:aspect-[3/4] lg:aspect-auto lg:h-[76vh]"
      >
        <div data-parallax class="absolute top-[-9%] left-0 h-[118%] w-full">
          {
            hero.video ? (
              /*
               * El video arranca sin src: lo engancha el JS sólo si la conexión
               * da y no hay prefers-reduced-motion. Si no, queda el poster.
               */
              <video
                data-hero-video
                class="h-full w-full object-cover"
                poster={hero.poster}
                aria-label={hero.alt}
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
              >
                {hero.video.webm && <source data-src={hero.video.webm} type="video/webm" />}
                {hero.video.mp4 && <source data-src={hero.video.mp4} type="video/mp4" />}
              </video>
            ) : (
              <img
                src={hero.poster}
                alt={hero.alt}
                width="1200"
                height="1500"
                class="h-full w-full object-cover"
              />
            )
          }
        </div>
      </div>
    </div>
  </div>
</section>
